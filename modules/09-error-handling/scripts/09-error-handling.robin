# Lab09_ErrorHandling — partial-ui (Chrome + bundled UI Elements; Cases A-E)
# Log schema matches assets/error-log-template.csv
# ON BLOCK ERROR: SET-only (ทบทวนจาก Lab 07 R6) — Get last error / log / Increase outside handler
# Get last error (validated paste): ERROR => LastError Reset: True
# On error policies (สอนใน LESSON/LAB Step 0.5): Stop flow (default) | Continue flow run | Retry action
#   — catch-up ใช้ Continue ผ่าน On block error + Loop retry (ไม่ใช้ Repeat action ไม่จำกัด)
# Screens: Lab09 Delay · Lab09 Dialogs · Lab01 Forms
# Case C: start timer → Wait contain-text ready (short FOR to practice retry) → unlock
# Case D: alert/confirm via ClickPressDialogButton + custom modal OK

SET WorkingRoot TO $'''C:\\PAD-Labs\\working\\lab09'''
SET ErrorLogPath TO $'''C:\\PAD-Labs\\logs\\lab09\\error-log.csv'''
SET RetryCount TO 0
SET Fatal TO False
SET CaseFailed TO False
SET WaitFailed TO False
SET ErrorLogHeader TO $'''Timestamp,CaseId,Severity,Message,RetryCount,Fatal'''

IF (Folder.IfFolderExists.DoesNotExist Path: $'''C:\\PAD-Labs\\logs\\lab09''') THEN
    Folder.Create FolderPath: $'''C:\\PAD-Labs\\logs''' FolderName: $'''lab09''' Folder=> Lab09LogFolder
END

File.WriteText File: ErrorLogPath TextToWrite: ErrorLogHeader AppendNewLine: True IfFileExists: File.IfFileExists.Overwrite Encoding: File.FileEncoding.UTF8

File.ReadTextFromFile.ReadText File: $'''%WorkingRoot%\\missing-file-path.txt''' Encoding: File.TextFileEncoding.UTF8 Content=> MissingPath

# Case A — Missing file
SET CaseFailed TO False
BLOCK
ON BLOCK ERROR all
    SET CaseFailed TO True
END
    File.ReadTextFromFile.ReadText File: MissingPath Encoding: File.TextFileEncoding.UTF8 Content=> MissingContent
END
IF CaseFailed = True THEN
    ERROR => LastError Reset: True
    DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateAndTime CurrentDateTime=> Now
    SET LogLine TO $'''%Now%,A,Error,%LastError.Message%,0,False'''
    File.WriteText File: ErrorLogPath TextToWrite: LogLine AppendNewLine: True IfFileExists: File.IfFileExists.Append Encoding: File.FileEncoding.UTF8
END

File.ReadTextFromFile.ReadText File: $'''%WorkingRoot%\\bad-url.txt''' Encoding: File.TextFileEncoding.UTF8 Content=> BadUrl

# Case B — Bad URL
SET CaseFailed TO False
BLOCK
ON BLOCK ERROR all
    SET CaseFailed TO True
END
    WebAutomation.LaunchChrome.LaunchChrome Url: BadUrl WindowState: WebAutomation.BrowserWindowState.Normal ClearCache: False ClearCookies: False WaitForPageToLoadTimeout: 30 Timeout: 30 BrowserInstance=> Browser
END
IF CaseFailed = True THEN
    ERROR => LastError Reset: True
    DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateAndTime CurrentDateTime=> Now
    SET LogLine TO $'''%Now%,B,Error,%LastError.Message%,0,False'''
    File.WriteText File: ErrorLogPath TextToWrite: LogLine AppendNewLine: True IfFileExists: File.IfFileExists.Append Encoding: File.FileEncoding.UTF8
END

# Recover browser after Case B failure
BLOCK
ON BLOCK ERROR all
END
    WebAutomation.LaunchChrome.LaunchChrome Url: $'''about:blank''' WindowState: WebAutomation.BrowserWindowState.Normal ClearCache: False ClearCookies: False WaitForPageToLoadTimeout: 30 Timeout: 30 BrowserInstance=> Browser
END

# Case C — Flaky wait + retry (max 3)
WebAutomation.GoToWebPage.GoToWebPage BrowserInstance: Browser Url: $'''https://ontoiq.tech/pad/11-delay.html''' WaitForPageToLoadTimeout: 60
WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab09 Delay']['Btn_StartTimer']) FOR 60
WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['Lab09 Delay']['Btn_StartTimer'] WaitForPageToLoadTimeout: 60
SET RetryCount TO 0
LOOP WHILE RetryCount < 3
    SET WaitFailed TO False
    BLOCK
    ON BLOCK ERROR all
        SET WaitFailed TO True
    END
        WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainText BrowserInstance: Browser Text: $'''พร้อมกรอกรหัส''') FOR 3
    END
    IF WaitFailed = True THEN
        Variables.IncreaseVariable Value: RetryCount IncrementValue: 1
        DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateAndTime CurrentDateTime=> Now
        SET LogLine TO $'''%Now%,C,Warning,wait-retry,%RetryCount%,False'''
        File.WriteText File: ErrorLogPath TextToWrite: LogLine AppendNewLine: True IfFileExists: File.IfFileExists.Append Encoding: File.FileEncoding.UTF8
    ELSE
        DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateAndTime CurrentDateTime=> Now
        SET LogLine TO $'''%Now%,C,Info,wait-success,%RetryCount%,False'''
        File.WriteText File: ErrorLogPath TextToWrite: LogLine AppendNewLine: True IfFileExists: File.IfFileExists.Append Encoding: File.FileEncoding.UTF8
        EXIT LOOP
    END
END

# Complete unlock after wait (Own Text of captcha label)
BLOCK
ON BLOCK ERROR all
END
    WebAutomation.GetDetailsOfElement BrowserInstance: Browser Control: appmask['Lab09 Delay']['Lbl_Captcha'] AttributeName: $'''Own Text''' AttributeValue=> CaptchaCode
    WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab09 Delay']['Txt_Captcha'] Text: CaptchaCode EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
    WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['Lab09 Delay']['Btn_Unlock'] WaitForPageToLoadTimeout: 60
END

# Case D — Dialogs (alert/confirm + custom modal)
WebAutomation.GoToWebPage.GoToWebPage BrowserInstance: Browser Url: $'''https://ontoiq.tech/pad/04-dialogs.html''' WaitForPageToLoadTimeout: 60
WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab09 Dialogs']['Btn_Alert']) FOR 60
WebAutomation.Click.ClickPressDialogButton BrowserInstance: Browser Control: appmask['Lab09 Dialogs']['Btn_Alert'] WaitForPageToLoadTimeout: 60 DialogButton: WebAutomation.DialogButton.OK
WebAutomation.Click.ClickPressDialogButton BrowserInstance: Browser Control: appmask['Lab09 Dialogs']['Btn_Confirm'] WaitForPageToLoadTimeout: 60 DialogButton: WebAutomation.DialogButton.OK
WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['Lab09 Dialogs']['Btn_OpenModal'] WaitForPageToLoadTimeout: 60
WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab09 Dialogs']['Btn_ModalOk']) FOR 60
WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['Lab09 Dialogs']['Btn_ModalOk'] WaitForPageToLoadTimeout: 60
DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateAndTime CurrentDateTime=> Now
SET LogLine TO $'''%Now%,D,Info,DIALOG_HANDLED,0,False'''
File.WriteText File: ErrorLogPath TextToWrite: LogLine AppendNewLine: True IfFileExists: File.IfFileExists.Append Encoding: File.FileEncoding.UTF8

# Case E — Recovery happy path (Forms)
WebAutomation.GoToWebPage.GoToWebPage BrowserInstance: Browser Url: $'''https://ontoiq.tech/pad/01-forms.html''' WaitForPageToLoadTimeout: 60
WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab01 Forms']['Txt_Name']) FOR 60
WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab01 Forms']['Txt_Name'] Text: $'''Recovery User''' EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab01 Forms']['Txt_Email'] Text: $'''recovery@example.com''' EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab01 Forms']['Txt_Amount'] Text: $'''1000''' EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab01 Forms']['Txt_Date'] Text: $'''2026-08-08''' EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab01 Forms']['Txt_Note'] Text: $'''Lab09 recovery''' EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['Lab01 Forms']['Btn_Submit'] WaitForPageToLoadTimeout: 60
DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateAndTime CurrentDateTime=> Now
SET LogLine TO $'''%Now%,E,Info,RECOVERY_OK,0,False'''
File.WriteText File: ErrorLogPath TextToWrite: LogLine AppendNewLine: True IfFileExists: File.IfFileExists.Append Encoding: File.FileEncoding.UTF8

# Challenge stubs F-I (do >=2 in class)
# F: https://ontoiq.tech/pad/10-ocr.html
# G: https://ontoiq.tech/pad/05-files.html
# H: https://ontoiq.tech/pad/08-iframe.html
# I: https://ontoiq.tech/pad/12-api.html

WebAutomation.CloseWebBrowser BrowserInstance: Browser

