# LabSCB_FormSearch — partial-ui
# URL: https://www.bot.or.th/th/search.html

SET SearchKeyword TO $'''อัตราแลกเปลี่ยน'''

WebAutomation.LaunchEdge.LaunchEdge Url: $'''https://www.bot.or.th/th/search.html''' WindowState: WebAutomation.BrowserWindowState.Normal ClearCache: False ClearCookies: False WaitForPageToLoadTimeout: 60 Timeout: 60 BrowserInstance=> Browser

# optional cookie banner
# REBIND: Btn_CookieNecessary — Press if present
# WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['SCB FormSearch']['Btn_CookieNecessary'] ...

# REBIND: Wait + Populate Txt_Search with %SearchKeyword%
WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['SCB FormSearch']['Txt_Search']) FOR 60
WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['SCB FormSearch']['Txt_Search'] Text: SearchKeyword EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace

# REBIND: Press Btn_Search (or SendKeys {Enter})
WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['SCB FormSearch']['Btn_Search'] WaitForPageToLoadTimeout: 60

# REBIND: Wait results then screenshot
WebAutomation.TakeScreenshot.TakeScreenshotSaveToFile BrowserInstance: Browser File: $'''C:\\PAD-Labs\\output\\lab-scb-alt\\search-proof.png''' FileFormat: WebAutomation.FileFormat.Png

WebAutomation.CloseWebBrowser BrowserInstance: Browser
