# LabSCB_StaticFxTable — partial-ui (Chrome + bundled UI Elements)
# URL: BOT stats ReportPage reportID=123
# ControlRepository at end — paste into an EMPTY desktop flow
# Elements: Tbl_BotFx (CSS: table#dgExcel)
# Wait Contain text USD then ExtractHtmlTable (8 cols: Seq Item D1..D6)
# CSV writes first 3 columns only, max 20 rows → bot-fx-table.csv

IF (Folder.IfFolderExists.DoesNotExist Path: $'''C:\\PAD-Labs\\output\\lab-scb-alt''') THEN
    Folder.Create FolderPath: $'''C:\\PAD-Labs\\output''' FolderName: $'''lab-scb-alt''' Folder=> ScbAltOutFolder
END

WebAutomation.LaunchChrome.LaunchChrome Url: $'''https://app.bot.or.th/BTWS_STAT/statistics/ReportPage.aspx?language=TH&reportID=123''' WindowState: WebAutomation.BrowserWindowState.Normal ClearCache: False ClearCookies: False WaitForPageToLoadTimeout: 90 Timeout: 90 BrowserInstance=> Browser

WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['SCB StaticFx']['Tbl_BotFx']) FOR 90
WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainText BrowserInstance: Browser Text: $'''USD''') FOR 90

WebAutomation.ExtractData.ExtractHtmlTable BrowserInstance: Browser Control: $'''table#dgExcel''' ExtractionParameters: {[$'''Seq''', $'''Item''', $'''D1''', $'''D2''', $'''D3''', $'''D4''', $'''D5''', $'''D6'''], [$'''''', $'''''', $'''''', $'''''', $'''''', $'''''', $'''''', $''''''] } PostProcessData: False TimeoutInSeconds: 60 ExtractedData=> BotFxTable

SET CsvBody TO $'''ลำดับ,รายการ,ค่าล่าสุด'''
SET RowLimit TO 0
LOOP FOREACH FxRow IN BotFxTable
    IF RowLimit >= 20 THEN
        EXIT LOOP
    END
    SET CsvLine TO $'''%FxRow[0]%,%FxRow[1]%,%FxRow[2]%'''
    SET CsvBody TO $'''%CsvBody%
%CsvLine%'''
    Variables.IncreaseVariable Value: RowLimit IncrementValue: 1
END

File.WriteText File: $'''C:\\PAD-Labs\\output\\lab-scb-alt\\bot-fx-table.csv''' TextToWrite: CsvBody AppendNewLine: True IfFileExists: File.IfFileExists.Overwrite Encoding: File.FileEncoding.UTF8

WebAutomation.CloseWebBrowser BrowserInstance: Browser

# [ControlRepository][PowerAutomateDesktop]

