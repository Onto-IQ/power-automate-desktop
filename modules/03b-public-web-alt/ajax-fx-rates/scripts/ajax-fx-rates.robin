# Lab03b_AjaxFxRates — partial-ui (Chrome + bundled UI Elements)
# URL: https://www.scb.co.th/th/personal-banking/foreign-exchange-rates
# ControlRepository at end — paste into an EMPTY desktop flow
# Elements: Tbl_FxRates (CSS: table.table-rate) — shell only; rates fill via AJAX
# Wait Contain text %CurrencyCode% before Extract (table node exists empty first)
# ExtractHtmlTable columns: Currency SellDDTT SellNotes BuyTT BuyExport BuyTCHQ BuyNotes
# Hits maps Currency / BankBuys(BuyTT=col3) / BankSells(SellDDTT=col1)

SET CurrencyCode TO $'''USD'''

IF (Folder.IfFolderExists.DoesNotExist Path: $'''C:\\PAD-Labs\\output\\lab03b''') THEN
    Folder.Create FolderPath: $'''C:\\PAD-Labs\\output''' FolderName: $'''lab03b''' Folder=> Lab03bOutFolder
END

WebAutomation.LaunchChrome.LaunchChrome Url: $'''https://www.scb.co.th/th/personal-banking/foreign-exchange-rates''' WindowState: WebAutomation.BrowserWindowState.Normal ClearCache: False ClearCookies: False WaitForPageToLoadTimeout: 90 Timeout: 90 BrowserInstance=> Browser

WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab03b AjaxFx']['Tbl_FxRates']) FOR 90
WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainText BrowserInstance: Browser Text: CurrencyCode) FOR 90

WebAutomation.ExtractData.ExtractHtmlTable BrowserInstance: Browser Control: $'''table.table-rate''' ExtractionParameters: {[$'''Currency''', $'''SellDDTT''', $'''SellNotes''', $'''BuyTT''', $'''BuyExport''', $'''BuyTCHQ''', $'''BuyNotes'''], [$'''''', $'''''', $'''''', $'''''', $'''''', $'''''', $''''''] } PostProcessData: False TimeoutInSeconds: 60 ExtractedData=> FxRatesTable

Variables.CreateNewDatatable InputTable: { ^['Currency', 'BankBuys', 'BankSells'] } DataTable=> Hits

LOOP FOREACH FxRow IN FxRatesTable
    IF Contains(FxRow[0], CurrencyCode, False) THEN
        Variables.AddRowToDataTable.AppendRowToDataTable DataTable: Hits RowToAdd: [FxRow[0], FxRow[3], FxRow[1]]
    END
END

SET CsvBody TO $'''Currency,BankBuys,BankSells'''
LOOP FOREACH HitRow IN Hits
    SET CsvLine TO $'''%HitRow[0]%,%HitRow[1]%,%HitRow[2]%'''
    SET CsvBody TO $'''%CsvBody%
%CsvLine%'''
END

File.WriteText File: $'''C:\\PAD-Labs\\output\\lab03b\\bank-fx-rates.csv''' TextToWrite: CsvBody AppendNewLine: True IfFileExists: File.IfFileExists.Overwrite Encoding: File.FileEncoding.UTF8

WebAutomation.CloseWebBrowser BrowserInstance: Browser

# [ControlRepository][PowerAutomateDesktop]

