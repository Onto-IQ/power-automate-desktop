# Lab03_StaticTable — partial-ui (Chrome + bundled UI Elements)
# URL: https://pad.ontoiq.tech/pad/03-table.html
# ControlRepository at end — paste into an EMPTY desktop flow
# Elements: Tbl_Employees (#tbl-employees)
# ExtractHtmlTable → static-table.csv (~5 employee rows)

IF (Folder.IfFolderExists.DoesNotExist Path: $'''C:\\PAD-Labs\\output\\lab03''') THEN
    Folder.Create FolderPath: $'''C:\\PAD-Labs\\output''' FolderName: $'''lab03''' Folder=> Lab03OutFolder
END

WebAutomation.LaunchChrome.LaunchChrome Url: $'''https://pad.ontoiq.tech/pad/03-table.html''' WindowState: WebAutomation.BrowserWindowState.Normal ClearCache: False ClearCookies: False WaitForPageToLoadTimeout: 60 Timeout: 60 BrowserInstance=> Browser

WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab03 StaticTable']['Tbl_Employees']) FOR 60
WebAutomation.ExtractData.ExtractHtmlTable BrowserInstance: Browser Control: $'''#tbl-employees''' ExtractionParameters: {[$'''Emp ID''', $'''Name''', $'''Department''', $'''Salary'''], [$'''''', $'''''', $'''''', $''''''] } PostProcessData: False TimeoutInSeconds: 60 ExtractedData=> StaticTable

SET CsvBody TO $'''Emp ID,Name,Department,Salary'''
LOOP FOREACH StaticRow IN StaticTable
    SET CsvLine TO $'''%StaticRow[0]%,%StaticRow[1]%,%StaticRow[2]%,%StaticRow[3]%'''
    SET CsvBody TO $'''%CsvBody%
%CsvLine%'''
END

File.WriteText File: $'''C:\\PAD-Labs\\output\\lab03\\static-table.csv''' TextToWrite: CsvBody AppendNewLine: True IfFileExists: File.IfFileExists.Overwrite Encoding: File.FileEncoding.UTF8

WebAutomation.CloseWebBrowser BrowserInstance: Browser

# [ControlRepository][PowerAutomateDesktop]

