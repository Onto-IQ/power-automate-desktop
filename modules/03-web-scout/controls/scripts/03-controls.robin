# Lab03_Controls — partial-ui (Chrome + bundled UI Elements)
# URL: https://pad.ontoiq.tech/pad/02-controls.html
# ControlRepository at end — paste into an EMPTY desktop flow
# Elements: Ddl_Department (#ddl-department) Chk_Terms (#chk-terms) Btn_Primary
# Set dropdown IT + check terms → GetDetails → controls-result.csv + screenshot

IF (Folder.IfFolderExists.DoesNotExist Path: $'''C:\\PAD-Labs\\output\\lab03''') THEN
    Folder.Create FolderPath: $'''C:\\PAD-Labs\\output''' FolderName: $'''lab03''' Folder=> Lab03OutFolder
END

WebAutomation.LaunchChrome.LaunchChrome Url: $'''https://pad.ontoiq.tech/pad/02-controls.html''' WindowState: WebAutomation.BrowserWindowState.Normal ClearCache: False ClearCookies: False WaitForPageToLoadTimeout: 60 Timeout: 60 BrowserInstance=> Browser

WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab03 Controls']['Ddl_Department']) FOR 60
WebAutomation.SetDropDownListValue.SetDropDownListValueByName BrowserInstance: Browser Control: appmask['Lab03 Controls']['Ddl_Department'] OptionsNames: $'''IT''' UseRegularExpressions: False
WebAutomation.SetCheckboxState.SetCheckboxState BrowserInstance: Browser Control: appmask['Lab03 Controls']['Chk_Terms'] CheckBoxState: WebAutomation.CheckBoxState.Checked

WebAutomation.GetDetailsOfElement BrowserInstance: Browser Control: appmask['Lab03 Controls']['Ddl_Department'] AttributeName: $'''Own Text''' AttributeValue=> SelectedOption
WebAutomation.GetDetailsOfElement BrowserInstance: Browser Control: appmask['Lab03 Controls']['Chk_Terms'] AttributeName: $'''Checked''' AttributeValue=> CheckState

SET CsvBody TO $'''SelectedOption,CheckState
%SelectedOption%,%CheckState%'''
File.WriteText File: $'''C:\\PAD-Labs\\output\\lab03\\controls-result.csv''' TextToWrite: CsvBody AppendNewLine: True IfFileExists: File.IfFileExists.Overwrite Encoding: File.FileEncoding.UTF8

WebAutomation.TakeScreenshot.TakeScreenshotSaveToFile BrowserInstance: Browser File: $'''C:\\PAD-Labs\\output\\lab03\\controls.png''' FileFormat: WebAutomation.FileFormat.Png

WebAutomation.CloseWebBrowser BrowserInstance: Browser

# [ControlRepository][PowerAutomateDesktop]

