# Lab03_Files — partial-ui (Chrome + bundled UI Elements)
# URL: https://pad.ontoiq.tech/pad/05-files.html
# ControlRepository at end — paste into an EMPTY desktop flow
# Elements: Lnk_DownloadCsv Inp_Upload Btn_ShowUpload
# Download via HTTP (Chrome-safe) + Populate file input for upload evidence

IF (Folder.IfFolderExists.DoesNotExist Path: $'''C:\\PAD-Labs\\downloads''') THEN
    Folder.Create FolderPath: $'''C:\\PAD-Labs''' FolderName: $'''downloads''' Folder=> DownloadsFolder
END
IF (Folder.IfFolderExists.DoesNotExist Path: $'''C:\\PAD-Labs\\output\\lab03''') THEN
    Folder.Create FolderPath: $'''C:\\PAD-Labs\\output''' FolderName: $'''lab03''' Folder=> Lab03OutFolder
END

WebAutomation.LaunchChrome.LaunchChrome Url: $'''https://pad.ontoiq.tech/pad/05-files.html''' WindowState: WebAutomation.BrowserWindowState.Normal ClearCache: False ClearCookies: False WaitForPageToLoadTimeout: 60 Timeout: 60 BrowserInstance=> Browser

WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab03 Files']['Lnk_DownloadCsv']) FOR 60
Web.DownloadFromWeb.DownloadToFolder Url: $'''https://pad.ontoiq.tech/pad/samples/orders.csv''' ConnectionTimeout: 30 FollowRedirection: True ClearCookies: False UserAgent: $'''''' Encoding: Web.Encoding.AutoDetect AcceptUntrustedCertificates: False DestinationFolder: $'''C:\\PAD-Labs\\downloads''' DownloadedFile=> DownloadedCsv

SET Evidence TO $'''download=ok; upload=pending'''
IF (File.IfFile.Exists File: $'''C:\\PAD-Labs\\working\\lab03\\upload-sample.txt''') THEN
    WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab03 Files']['Inp_Upload']) FOR 60
    WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab03 Files']['Inp_Upload'] Text: $'''C:\\PAD-Labs\\working\\lab03\\upload-sample.txt''' EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
    WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['Lab03 Files']['Btn_ShowUpload'] WaitForPageToLoadTimeout: 60
    SET Evidence TO $'''download=ok; upload=ok'''
END

File.WriteText File: $'''C:\\PAD-Labs\\output\\lab03\\files-evidence.txt''' TextToWrite: Evidence AppendNewLine: True IfFileExists: File.IfFileExists.Overwrite Encoding: File.FileEncoding.UTF8

WebAutomation.CloseWebBrowser BrowserInstance: Browser

# [ControlRepository][PowerAutomateDesktop]

