# Lab03_Catalog — partial-ui (Chrome + bundled UI Elements)
# URL: https://pad.ontoiq.tech/pad/19-catalog.html · ~24 rows / 3 pages
# ControlRepository at end — paste into an EMPTY desktop flow
# Elements: Tbl_Products (#tbl-products) Btn_NextPage (#btn-next-page)
# Loop: Extract page → append → GetDetails Disabled on Next → exit or Click Next

Variables.CreateNewDatatable InputTable: { ^['SKU', 'Product', 'Price', 'Category'] } DataTable=> CatalogHits
SET MaxPages TO 10
SET PageCount TO 0

IF (Folder.IfFolderExists.DoesNotExist Path: $'''C:\\PAD-Labs\\output\\lab03''') THEN
    Folder.Create FolderPath: $'''C:\\PAD-Labs\\output''' FolderName: $'''lab03''' Folder=> Lab03OutFolder
END

WebAutomation.LaunchChrome.LaunchChrome Url: $'''https://pad.ontoiq.tech/pad/19-catalog.html''' WindowState: WebAutomation.BrowserWindowState.Normal ClearCache: False ClearCookies: False WaitForPageToLoadTimeout: 60 Timeout: 60 BrowserInstance=> Browser

LOOP WHILE PageCount < MaxPages
    WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab03 Catalog']['Tbl_Products']) FOR 60
    WebAutomation.ExtractData.ExtractHtmlTable BrowserInstance: Browser Control: $'''#tbl-products''' ExtractionParameters: {[$'''SKU''', $'''Product''', $'''Price''', $'''Category'''], [$'''''', $'''''', $'''''', $''''''] } PostProcessData: False TimeoutInSeconds: 60 ExtractedData=> PageTable

    LOOP FOREACH ProductRow IN PageTable
        Variables.AddRowToDataTable.AppendRowToDataTable DataTable: CatalogHits RowToAdd: [ProductRow[0], ProductRow[1], ProductRow[2], ProductRow[3]]
    END

    Variables.IncreaseVariable Value: PageCount IncrementValue: 1

    WebAutomation.GetDetailsOfElement BrowserInstance: Browser Control: appmask['Lab03 Catalog']['Btn_NextPage'] AttributeName: $'''Disabled''' AttributeValue=> AttributeValue
    IF AttributeValue = True THEN
        EXIT LOOP
    END
    IF AttributeValue = $'''true''' THEN
        EXIT LOOP
    END
    IF AttributeValue = $'''True''' THEN
        EXIT LOOP
    END

    WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['Lab03 Catalog']['Btn_NextPage'] WaitForPageToLoadTimeout: 60
END

SET CsvPath TO $'''C:\\PAD-Labs\\output\\lab03\\catalog-products.csv'''
File.WriteText File: CsvPath TextToWrite: $'''SKU,Product,Price,Category''' AppendNewLine: True IfFileExists: File.IfFileExists.Overwrite Encoding: File.FileEncoding.UTF8

LOOP FOREACH CatalogRow IN CatalogHits
    SET CsvLine TO CatalogRow[0]
    SET CsvLine TO $'''%CsvLine%,%CatalogRow[1]%'''
    SET CsvLine TO $'''%CsvLine%,%CatalogRow[2]%'''
    SET CsvLine TO $'''%CsvLine%,%CatalogRow[3]%'''
    File.WriteText File: CsvPath TextToWrite: CsvLine AppendNewLine: True IfFileExists: File.IfFileExists.Append Encoding: File.FileEncoding.UTF8
END

WebAutomation.CloseWebBrowser BrowserInstance: Browser

# [ControlRepository][PowerAutomateDesktop]

