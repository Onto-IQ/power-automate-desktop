# Lab03_AjaxTable — partial-ui (Chrome + bundled UI Elements)
# URL: https://pad.ontoiq.tech/pad/09-ajax-table.html · MinAmount=1500
# ControlRepository at end — paste into an EMPTY desktop flow
# Elements: Btn_RefreshOrders (#btn-refresh-orders) Tbl_Orders (#tbl-orders)
# Refresh → Wait rows → ExtractHtmlTable → filter Amount >= MinAmount → ajax-orders.csv

SET MinAmount TO 1500

IF (Folder.IfFolderExists.DoesNotExist Path: $'''C:\\PAD-Labs\\output\\lab03''') THEN
    Folder.Create FolderPath: $'''C:\\PAD-Labs\\output''' FolderName: $'''lab03''' Folder=> Lab03OutFolder
END

WebAutomation.LaunchChrome.LaunchChrome Url: $'''https://pad.ontoiq.tech/pad/09-ajax-table.html''' WindowState: WebAutomation.BrowserWindowState.Normal ClearCache: False ClearCookies: False WaitForPageToLoadTimeout: 60 Timeout: 60 BrowserInstance=> Browser

WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab03 Ajax']['Btn_RefreshOrders']) FOR 60
WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['Lab03 Ajax']['Btn_RefreshOrders'] WaitForPageToLoadTimeout: 60

WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab03 Ajax']['Tbl_Orders']) FOR 60
WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainText BrowserInstance: Browser Text: $'''Order''') FOR 60

WebAutomation.ExtractData.ExtractHtmlTable BrowserInstance: Browser Control: $'''#tbl-orders''' ExtractionParameters: {[$'''Order ID''', $'''Customer''', $'''Amount''', $'''Status'''], [$'''''', $'''''', $'''''', $''''''] } PostProcessData: False TimeoutInSeconds: 60 ExtractedData=> AjaxTable

Variables.CreateNewDatatable InputTable: { ^['Order ID', 'Customer', 'Amount', 'Status'] } DataTable=> Hits

LOOP FOREACH AjaxRow IN AjaxTable
    Text.ToNumber Text: AjaxRow[2] Number=> AmountNumber
    IF AmountNumber >= MinAmount THEN
        Variables.AddRowToDataTable.AppendRowToDataTable DataTable: Hits RowToAdd: [AjaxRow[0], AjaxRow[1], AjaxRow[2], AjaxRow[3]]
    END
END

SET CsvPath TO $'''C:\\PAD-Labs\\output\\lab03\\ajax-orders.csv'''
File.WriteText File: CsvPath TextToWrite: $'''Order ID,Customer,Amount,Status''' AppendNewLine: True IfFileExists: File.IfFileExists.Overwrite Encoding: File.FileEncoding.UTF8

LOOP FOREACH HitRow IN Hits
    SET CsvLine TO HitRow[0]
    SET CsvLine TO $'''%CsvLine%,%HitRow[1]%'''
    SET CsvLine TO $'''%CsvLine%,%HitRow[2]%'''
    SET CsvLine TO $'''%CsvLine%,%HitRow[3]%'''
    File.WriteText File: CsvPath TextToWrite: CsvLine AppendNewLine: True IfFileExists: File.IfFileExists.Append Encoding: File.FileEncoding.UTF8
END

WebAutomation.CloseWebBrowser BrowserInstance: Browser

# [ControlRepository][PowerAutomateDesktop]

