# Lab08_ExcelWebRoundtrip — partial-ui (Chrome + bundled UI Elements)
# Login 06 → For each New lead → High=Wizard 07 else Forms 01 → leads-output.xlsx
# ControlRepository at end — paste into an EMPTY desktop flow
# Screens: Lab08 Login · Lab01 Forms · Lab08 Wizard

SET WorkingRoot TO $'''C:\\PAD-Labs\\working\\lab08'''
SET OutputPath TO $'''C:\\PAD-Labs\\output\\lab08\\leads-output.xlsx'''

IF (Folder.IfFolderExists.DoesNotExist Path: $'''C:\\PAD-Labs\\output\\lab08''') THEN
    Folder.Create FolderPath: $'''C:\\PAD-Labs\\output''' FolderName: $'''lab08''' Folder=> Lab08OutFolder
END

Excel.LaunchExcel.LaunchAndOpen Path: $'''%WorkingRoot%\\leads-input.xlsx''' Visible: True ReadOnly: False LoadAddInsAndMacros: False Instance=> Excel
Excel.SetActiveWorksheet.ActivateWorksheetByName Instance: Excel Name: $'''Leads'''
Excel.ReadFromExcel.ReadAllCells Instance: Excel ReadAsText: False FirstLineIsHeader: True RangeValue=> Leads

WebAutomation.LaunchChrome.LaunchChrome Url: $'''https://ontoiq.tech/pad/06-login.html''' WindowState: WebAutomation.BrowserWindowState.Normal ClearCache: False ClearCookies: False WaitForPageToLoadTimeout: 60 Timeout: 60 BrowserInstance=> Browser
WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab08 Login']['Txt_Username']) FOR 60
WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab08 Login']['Txt_Username'] Text: $'''demo''' EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab08 Login']['Txt_Password'] Text: $'''demo''' EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['Lab08 Login']['Btn_Login'] WaitForPageToLoadTimeout: 60

Variables.CreateNewDatatable InputTable: { ^['LeadId', 'FullName', 'Email', 'Priority', 'Status', 'WebResult', 'SubmittedAt'] } DataTable=> Results

DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateOnly CurrentDateTime=> TodayDate
Text.ConvertDateTimeToText.FromCustomDateTime DateTime: TodayDate CustomFormat: $'''yyyy-MM-dd''' Result=> TodayText

LOOP FOREACH CurrentLead IN Leads
    IF CurrentLead['Status'] = $'''New''' THEN
        IF IsEmpty(CurrentLead['Email']) THEN
        ELSE IF CurrentLead['Priority'] = $'''High''' THEN
            WebAutomation.GoToWebPage.GoToWebPage BrowserInstance: Browser Url: $'''https://ontoiq.tech/pad/07-wizard.html''' WaitForPageToLoadTimeout: 60
            WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab08 Wizard']['Txt_Customer']) FOR 60
            WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab08 Wizard']['Txt_Customer'] Text: CurrentLead['FullName'] EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
            WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab08 Wizard']['Txt_Company'] Text: CurrentLead['Company'] EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
            WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['Lab08 Wizard']['Btn_Next'] WaitForPageToLoadTimeout: 60
            WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab08 Wizard']['Ddl_Type']) FOR 60
            WebAutomation.SetDropDownListValue.SetDropDownListValueByName BrowserInstance: Browser Control: appmask['Lab08 Wizard']['Ddl_Type'] OptionsNames: $'''Invoice''' UseRegularExpressions: False
            WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab08 Wizard']['Txt_Qty'] Text: $'''1''' EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
            WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['Lab08 Wizard']['Btn_Next'] WaitForPageToLoadTimeout: 60
            WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab08 Wizard']['Btn_Finish']) FOR 60
            WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['Lab08 Wizard']['Btn_Finish'] WaitForPageToLoadTimeout: 60
            SET WebResult TO $'''WizardSubmitted'''
        ELSE
            WebAutomation.GoToWebPage.GoToWebPage BrowserInstance: Browser Url: $'''https://ontoiq.tech/pad/01-forms.html''' WaitForPageToLoadTimeout: 60
            WAIT (WebAutomation.WaitForWebPageContent.WebPageToContainElement BrowserInstance: Browser Control: appmask['Lab01 Forms']['Txt_Name']) FOR 60
            WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab01 Forms']['Txt_Name'] Text: CurrentLead['FullName'] EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
            WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab01 Forms']['Txt_Email'] Text: CurrentLead['Email'] EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
            WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab01 Forms']['Txt_Amount'] Text: $'''1000''' EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
            WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab01 Forms']['Txt_Date'] Text: TodayText EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
            WebAutomation.PopulateTextField.PopulateTextField BrowserInstance: Browser Control: appmask['Lab01 Forms']['Txt_Note'] Text: CurrentLead['Interest'] EmulateTyping: False UnfocusAfterPopulate: True Mode: WebAutomation.PopulateTextMode.Replace
            WebAutomation.Click.Click BrowserInstance: Browser Control: appmask['Lab01 Forms']['Btn_Submit'] WaitForPageToLoadTimeout: 60
            SET WebResult TO $'''FormSubmitted'''
        END
        DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateAndTime CurrentDateTime=> SubmittedAt
        Variables.AddRowToDataTable.AppendRowToDataTable DataTable: Results RowToAdd: [CurrentLead['LeadId'], CurrentLead['FullName'], CurrentLead['Email'], CurrentLead['Priority'], $'''Submitted''', WebResult, SubmittedAt]
    END
END

IF (File.IfFile.Exists File: OutputPath) THEN
    File.Delete Files: OutputPath
END
Excel.WriteToExcel.WriteCells Instance: Excel Value: Results WorksheetName: $'''Results''' StartColumn: 1 StartRow: 1 FirstLineIsHeader: True
Excel.SaveAs.SaveAs Instance: Excel DocumentFormat: Excel.DocumentFormat.OpenXmlWorkbook DocumentPath: OutputPath
Excel.CloseExcel.Close Instance: Excel
WebAutomation.CloseWebBrowser BrowserInstance: Browser

